<?php
$roll=$_GET['RollNo'];
$sel_query="SELECT * FROM gradebook WHERE RollNo='".$roll."'";
$result = mysqli_query($conn,$sel_query);
$row = mysqli_fetch_assoc($result);
if (mysqli_num_rows($result) > 0) {
    echo "<table border='1' cellspacing='10'>";
    echo "<th>RollNo:</th>";
    echo "<td>".$row["RollNo"]."</td>";
    echo "<th>Name:</th>";
    echo "<td>".$row["Name"]."</td>";
    while ($row = mysqli_fetch_assoc($result)) {
        echo "<tr>";
        echo "<th>Subject:</th>";
        echo "<td>".$row["SubjectName"]."</td>";
        echo "</tr>";
        echo "<tr>";
        echo "<th>Obtained Marks in Quiz 1:</th>";
        echo "<td>".$row["Obtainedquiz1"]."</td>";
        echo "<th>Total Marks of Quiz 1:</th>";
        echo "<td>".$row["Totalquiz1"]."</td>";
        echo "<th>Obtained Marks in Mid-Term:</th>";
        echo "<td>".$row["ObtainedMidTerm"]."</td>";
        echo "<th>Total Marks of Mid-Term:</th>";
        echo "<td>".$row["TotalMidTerm"]."</td>";
        echo "</tr>";
        echo "<tr>";
        echo "<th>Obtained Marks in Quiz 2:</th>";
        echo "<td>".$row["Obtainedquiz2"]."</td>";
        echo "<th>Total Marks of Quiz 2:</th>";
        echo "<td>".$row["Totalquiz2"]."</td>";
        echo "<th>Obtained Marks in Final:</th>";
        echo "<td>".$row["ObtainedFinal"]."</td>";
        echo "<th>Total Marks of Final:</th>";
        echo "<td>".$row["TotalFinal"]."</td>";
        echo "</tr>";
        echo "<tr>";
        echo "<th>Percentage:</th>";
        echo "<td>".$row["Percentage"]."</td>";
		echo "<th>Grade:</th>";
        echo "<td>".$row["Grade"]."</td>";
        echo "<td colspan='6'></td>";
        echo "</tr>";
        // add an empty row after each subject
        echo "<tr><td colspan='8'></td></tr>";
    }
    echo "</table>";
} else {
    echo "No record found for RollNo: ".$roll;
}
